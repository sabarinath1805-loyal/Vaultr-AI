# Root env for docker-compose: frontend build-time vars (baked into the bundle).
# Backend secrets live in backend/.env (see backend/.env.example).
#
# The public key below is a placeholder. Use the key printed by `supabase start`
# only in a local, uncommitted `.env` file.

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
GOTRUE_MAILER_AUTOCONFIRM=true

# Local Supabase publishable/anon key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_placeholder
