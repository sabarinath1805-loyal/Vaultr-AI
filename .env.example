# Canonical Vaultr environment template. Copy to .env.local; do not commit secrets.
# Every value below is optional unless the feature description says otherwise.

# Groq hosted models and fallback routing.
GROQ_API_KEY=
# Google Gemini models and fallback routing.
GEMINI_API_KEY=
# Ollama Cloud models.
OLLAMA_API_KEY=
# ClaudeOpus or another OpenAI-compatible gateway.
CLAUDEOPUS_API_KEY=
# OpenAI-compatible gateway base URL.
ANTHROPIC_BASE_URL=https://api.claudeopus.pro
# Cerebras-hosted models.
CEREBRAS_API_KEY=
# Tavily web/legal search enrichment.
TAVILY_API_KEY=
# Harvard Caselaw Access Project search (optional).
HARVARD_CAP_API_KEY=
# Jina AI document embeddings for personal RAG.
JINA_API_KEY=

# Local Ollama server; Private Mode defaults to this URL.
OLLAMA_URL=http://localhost:11434

# Supabase project URL and browser-safe anon key for auth/cloud RAG.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase service-role key; never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Opt-in persisted Supabase auth sessions.
NEXT_PUBLIC_SUPABASE_PERSIST_SESSION=false

# Optional generated-file paths. Defaults are chosen automatically.
DOWNLOAD_DIR=
TMPDIR=
# Next.js output mode; standalone is required for the desktop packaging flow.
NEXT_OUTPUT=standalone
