# Canonical template: copy this file to .env.local and fill in only the providers you use.

# --- Hosted model providers -------------------------------------------------
# Groq API key. Used for hosted chat, fast fallbacks, and legal-query extraction.
GROQ_API_KEY=

# Google Gemini API key. Enables Gemini models and fallback responses.
GEMINI_API_KEY=

# Ollama Cloud API key. Used only for Ollama Cloud models.
OLLAMA_API_KEY=

# ClaudeOpus or another OpenAI-compatible gateway key.
CLAUDEOPUS_API_KEY=

# Base URL for the ClaudeOpus/OpenAI-compatible gateway.
ANTHROPIC_BASE_URL=https://api.claudeopus.pro

# Cerebras API key, when using Cerebras-hosted models.
CEREBRAS_API_KEY=

# Tavily API key for web-backed legal research and citation enrichment.
TAVILY_API_KEY=

# Harvard Caselaw Access Project API key (optional legal database source).
HARVARD_CAP_API_KEY=

# Jina AI API key for document embeddings and personal RAG.
JINA_API_KEY=

# --- Local/private mode -----------------------------------------------------
# Local Ollama server URL. Defaults to http://localhost:11434.
OLLAMA_URL=http://localhost:11434

# --- Supabase ---------------------------------------------------------------
# Supabase project URL. Enables auth, usage logging, and cloud RAG when paired
# with the public anon key below.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase anon/public key. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service-role key. Keep this secret and never expose it
# to client bundles.
SUPABASE_SERVICE_ROLE_KEY=

# Set true only if you explicitly want Supabase auth sessions persisted.
NEXT_PUBLIC_SUPABASE_PERSIST_SESSION=false

# --- Local server paths -----------------------------------------------------
# Optional directory for generated DOCX/PDF downloads. Defaults to a temp dir.
DOWNLOAD_DIR=

# Optional temp directory used for generated files. Defaults to the OS temp dir.
TMPDIR=

# Optional Next output mode. The default is standalone.
NEXT_OUTPUT=standalone
