# Groq API key — get yours at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API key — get yours at aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Cloud API key — get yours at ollama.com
OLLAMA_API_KEY=your_ollama_api_key_here

# Anthropic via ClaudeOpus.pro
CLAUDEOPUS_API_KEY=your_claudeopus_api_key_here
ANTHROPIC_BASE_URL=https://api.claudeopus.pro

# Supabase — beta user management + auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
